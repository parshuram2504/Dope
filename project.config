[project]
	description = Dope is a ecommerce application
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/parshuram2504
[access "refs/for/refs/*"]
	read = group user/parshuram2504
	push = group user/parshuram2504
	label-Code-Review = -2..+2 group user/parshuram2504
	label-Verified = -1..+1 group user/parshuram2504
	rebase = group user/parshuram2504
	removeReviewer = group user/parshuram2504
	submit = group user/parshuram2504
[access "refs/heads/*"]
	read = group user/parshuram2504
	create = group user/parshuram2504
	push = +force group user/parshuram2504
	pushMerge = group user/parshuram2504
[access "refs/tags/*"]
	push = group user/parshuram2504
	push = +force group user/parshuram2504
